
import java.util.Scanner;

public class Scrabble {

    public static boolean canSpell(String tiles, String word) {
        tiles = tiles.toLowerCase();
        word = word.toLowerCase();

        for (int i = 0; i < word.length(); i++) {
            char letter = word.charAt(i);

            int position = tiles.indexOf(letter);

            if (position == -1) {
                return false;
            }

            tiles = tiles.substring(0, position)
                  + tiles.substring(position + 1);
        }

        return true;
    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.print("Enter your tiles: ");
        String tiles = input.next();

        System.out.print("Enter the word to spell: ");
        String word = input.next();

        System.out.println(canSpell(tiles, word));
    }
}
